<Window x:Class="SyberiaDatamine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Syberia DataMine" Height="900" Width="1650"
        WindowState="Maximized"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#1E1E1E" Foreground="#CCCCCC">

    <Window.Resources>

        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#2D2D30"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"       Color="#2D2D30"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"      Color="#CCCCCC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#094771"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}"   Color="#3C3C3C"/>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background"      Value="#3C3C3C"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#569CD6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaBtn" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#2D2D30"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderBrush"     Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Height"     Value="24"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2D2E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="2,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected"  Value="True">  <Setter Property="Background" Value="#094771"/> <Setter Property="Foreground" Value="White"/> </Trigger>
                <Trigger Property="IsMouseOver" Value="True"> <Setter Property="Background" Value="#2A2D2E"/> </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#858585"/>
            <Setter Property="BorderBrush"   Value="Transparent"/>
            <Setter Property="Padding"       Value="14,6"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#569CD6"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground"       Value="#CCCCCC"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Padding"          Value="8,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="✓"
                                           FontSize="10"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Slide">
                                    <Border Background="#2D2D30"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            Padding="0,2">
                                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                       KeyboardNavigation.DirectionalNavigation="Cycle"
                                                       KeyboardNavigation.TabNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>

                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>

                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background"       Value="#3C3C3C"/>
            <Setter Property="Height"           Value="1"/>
            <Setter Property="Margin"           Value="0,3"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}"
                                Height="{TemplateBinding Height}"
                                Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background"      Value="#2D2D30"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"       Value="#3C3C3C"/>
            <Setter Property="Foreground"       Value="#CCCCCC"/>
            <Setter Property="BorderBrush"      Value="#555555"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,24,3"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <ToggleButton x:Name="ToggleButton"
                                          HorizontalAlignment="Right"
                                          Width="20"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <Path Data="M0,0 L4,5 L8,0 Z"
                                      Fill="#AAAAAA"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,1,0,0"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#2D2D30"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#569CD6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Background="#1E1E1E">

        <DockPanel DockPanel.Dock="Top" Background="#2D2D30" Height="40" LastChildFill="False">
            <Menu DockPanel.Dock="Left" Background="Transparent" Margin="4,0" VerticalAlignment="Center">
                <MenuItem Header="File" Height="32">
                    <MenuItem Header="Open File…"   Click="MenuItem_LoadFile"/>
                    <MenuItem Header="Open Folder…" Click="MenuItem_LoadFolder"/>
                    <Separator/>
                    <MenuItem Header="Index Texture Sources…" Click="MenuItem_IndexTextureSources"/>
                    <Separator/>
                    <MenuItem Header="Exit"          Click="MenuItem_Exit"/>
                </MenuItem>
                <MenuItem Header="Export" Height="32">
                    <MenuItem Header="Export All…"      Click="MenuItem_ExportAll"/>
                    <MenuItem Header="Export Selected…" Click="MenuItem_ExportSelected"/>
                </MenuItem>
                <MenuItem Header="View" Height="32">
                    <MenuItem Header="Expand All"   Click="MenuItem_ExpandAll"/>
                    <MenuItem Header="Collapse All" Click="MenuItem_CollapseAll"/>
                    <Separator/>
                    <MenuItem x:Name="HideUnknownMenuItem" Header="Hide Unknown Files"
                              Click="MenuItem_ToggleHideUnknown" IsCheckable="True"/>
                    <Separator/>
                    <MenuItem Header="Reset Layout" Click="MenuItem_ResetLayout"/>
                </MenuItem>
            </Menu>
            <TextBlock DockPanel.Dock="Right" Text="Syberia DataMine" Foreground="#555"
                       FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
        </DockPanel>

        <Border x:Name="FfmpegBanner" DockPanel.Dock="Top" Background="#2D2311"
                BorderBrush="#7A5F00" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FfmpegBannerText"   Text="Setting up FFmpeg…" FontWeight="SemiBold" Foreground="#F0C040" FontSize="12"/>
                    <TextBlock x:Name="FfmpegBannerDetail" Text="" FontSize="10" Foreground="#C0A030" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" x:Name="FfmpegBannerProgress" Height="6"
                             Margin="12,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="0"
                             Background="#3C3000" Foreground="#F0C040"/>
                <Button Grid.Column="2" x:Name="FfmpegBannerRetry" Content="Retry"
                        Style="{StaticResource DarkButton}" Margin="8,0,0,0"
                        Click="FfmpegBannerRetry_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#2D2D30" BorderBrush="#3C3C3C"
                BorderThickness="0,1,0,0" Height="24">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#858585"
                       FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
        </Border>

        <Grid Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.6*" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3C3C3C"
                        BorderThickness="0,0,0,1" Padding="10,6">
                    <TextBlock Text="EXPLORER" Foreground="#858585"
                               FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <TextBox Grid.Row="1" x:Name="SearchBox" Margin="8,6,8,4" Height="28"
                         TextChanged="SearchBox_TextChanged"
                         Background="#3C3C3C" Foreground="#CCCCCC"
                         CaretBrush="#CCCCCC" BorderBrush="#555" BorderThickness="1"
                         Padding="8,4" FontSize="12"/>
                <TreeView Grid.Row="2" x:Name="FileTreeView"
                          Background="Transparent" BorderThickness="0"
                          Foreground="#CCCCCC"
                          TreeViewItem.Selected="TreeViewItem_Selected"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#1E1E1E" BorderThickness="0"/>

            <Grid Grid.Column="2" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#2D2D30"
                        BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Height="34">
                    <DockPanel LastChildFill="False">
                    <TextBlock Text="ASSETS" Foreground="#858585"
                               FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0"
                               DockPanel.Dock="Left"/>
                    <ComboBox x:Name="TypeFilterCombo" DockPanel.Dock="Right"
                              Width="110" Margin="6,4" FontSize="11"
                              Background="#3C3C3C" Foreground="#CCCCCC"
                              PreviewMouseLeftButtonDown="TypeFilterComboBox_PreviewMouseLeftButtonDown"
                              SelectionChanged="TypeFilterCombo_SelectionChanged"/>
                    </DockPanel>
                </Border>
                <DataGrid Grid.Row="1" x:Name="AssetGrid"
                          AutoGenerateColumns="False"
                          SelectionChanged="AssetGrid_SelectionChanged"
                          MouseRightButtonDown="AssetGrid_MouseRightButtonDown"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          CanUserResizeRows="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          ColumnHeaderHeight="26"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#1A1A1A"
                          SelectionMode="Extended"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#094771"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="#2A2D2E"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"   Color="#CCCCCC"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#37373D"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="*" IsReadOnly="True" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#CCCCCC"
                                               Padding="4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Container" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Container}" Foreground="#858585"
                                               Padding="4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Type" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}" Foreground="#4EC9B0"
                                               Padding="4,0" VerticalAlignment="Center" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Size" Width="72" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeFormatted}" Foreground="#858585"
                                               Padding="4,0" VerticalAlignment="Center"
                                               FontSize="11" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#2D2D30"
                                     BorderBrush="#555"
                                     Padding="0">
                            <ContextMenu.Resources>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                    <Setter Property="Background" Value="#2D2D30"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter ContentSource="Header"
                                                                      RecognizesAccessKey="True"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="#555555"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="Export file…"     Click="Context_ExportFile"/>
                            <MenuItem Header="Export selected…" Click="MenuItem_ExportSelected"/>
                            <MenuItem Header="Export all…"      Click="MenuItem_ExportAll"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#1E1E1E" BorderThickness="0"/>

            <Grid Grid.Column="4" Background="#1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2D2D30"
                        BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Height="28">
                    <TextBlock x:Name="PreviewMetadata" Foreground="#858585"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="8,0"/>
                </Border>

                <TabControl Grid.Row="1" Background="#1E1E1E"
                            BorderBrush="#3C3C3C" BorderThickness="0,0,0,0">

                <TabItem Header="Preview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="#1E1E1E">
                        <StackPanel Orientation="Vertical" Margin="12"
                                    HorizontalAlignment="Center">

                            <Border x:Name="TextureReferencePanel"
                                    Visibility="Collapsed"
                                    MaxWidth="720"
                                    Background="#1A1A1A"
                                    BorderBrush="#3C3C3C"
                                    BorderThickness="1"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="TextureReferenceTitle"
                                               Foreground="#FFB86C"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TextureReferenceBody"
                                               Foreground="#FFB86C"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="MediaPanel" Visibility="Collapsed"
                                  MaxWidth="720" Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#111" CornerRadius="4" Padding="4">
                                    <Grid>
                                        <Image x:Name="VideoPreview"
                                            Stretch="Uniform" Height="360"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border x:Name="VideoOverlay" Background="#AA000000"
                                                Visibility="Collapsed" CornerRadius="4">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="VideoOverlayText" Text="Loading…"
                                                           Foreground="White" FontSize="13"
                                                           FontWeight="SemiBold" TextAlignment="Center"/>
                                                <ProgressBar x:Name="VideoOverlayProgress"
                                                             Width="200" Height="6" Margin="0,10,0,0"
                                                             IsIndeterminate="True" Foreground="#569CD6"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#1A1A1A"
                                        CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="MediaPlayButton"  Content="▶" Style="{StaticResource MediaBtn}" Margin="0,0,4,0" Click="MediaPlay_Click"/>
                                        <Button Grid.Column="1" x:Name="MediaPauseButton" Content="⏸" Style="{StaticResource MediaBtn}" Margin="0,0,4,0" Click="MediaPause_Click"/>
                                        <Button Grid.Column="2" x:Name="MediaStopButton"  Content="⏹" Style="{StaticResource MediaBtn}" Margin="0,0,10,0" Click="MediaStop_Click"/>
                                        <Slider Grid.Column="3" x:Name="MediaPositionSlider"
                                                Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                                                VerticalAlignment="Center"
                                                PreviewMouseDown="MediaPositionSlider_PreviewMouseDown"
                                                PreviewMouseUp="MediaPositionSlider_PreviewMouseUp"
                                                ValueChanged="MediaPositionSlider_ValueChanged"/>
                                        <TextBlock Grid.Column="4" x:Name="MediaTimeText"
                                                   Text="0:00 / 0:00" Foreground="#858585"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Margin="8,0" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="5" x:Name="MediaVolumeSlider"
                                                Minimum="0" Maximum="1" Value="0.8"
                                                VerticalAlignment="Center"
                                                ValueChanged="MediaVolumeSlider_ValueChanged"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Image x:Name="ImagePreview" MaxHeight="512" MaxWidth="512"
                                   Stretch="Uniform" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                            <TextBox x:Name="HexPreviewText" IsReadOnly="True" TextWrapping="NoWrap"
                                     Background="#111" Foreground="#CE9178"
                                     FontFamily="Consolas" FontSize="10" Padding="10"
                                     MaxHeight="400" Visibility="Collapsed"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="1" BorderBrush="#3C3C3C"/>

                            <StackPanel x:Name="NemoPanel" Visibility="Collapsed" MaxWidth="720">
                                <Border Background="#1A1A1A" CornerRadius="4"
                                        Padding="12,8" Margin="0,0,0,8">
                                    <TextBlock x:Name="NemoHeaderText" Foreground="#9CDCFE"
                                               FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <Border Background="#1A1A1A" CornerRadius="4" Padding="4">
                                    <TreeView x:Name="NemoObjectTree" Background="Transparent"
                                              BorderThickness="0" MaxHeight="500"
                                              Foreground="#CCCCCC">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Objects}">
                                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                                    <TextBlock Text="{Binding GroupName}"
                                                               Foreground="#4EC9B0"
                                                               FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="  "/>
                                                    <TextBlock Text="{Binding CountLabel}"
                                                               Foreground="#569CD6" FontSize="11"/>
                                                </StackPanel>
                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="#CCCCCC" FontSize="11"/>
                                                            <TextBlock Text="  "/>
                                                            <TextBlock Text="{Binding ClassName}"
                                                                       Foreground="#858585" FontSize="10"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </Border>
                            </StackPanel>

                            <Border x:Name="MeshViewportBorder" Visibility="Collapsed" MaxWidth="720"
                                    Background="#111111" CornerRadius="4" Margin="0,0,0,8">
                                <StackPanel>
                                    <Viewport3D x:Name="MeshViewport3D" Height="450" ClipToBounds="True"
                                                MouseDown="MeshViewport_MouseDown"
                                                MouseMove="MeshViewport_MouseMove"
                                                MouseUp="MeshViewport_MouseUp"
                                                MouseWheel="MeshViewport_MouseWheel">
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera x:Name="MeshCamera"
                                                               Position="0,0,5"
                                                               LookDirection="0,0,-1"
                                                               UpDirection="0,1,0"
                                                               FieldOfView="60"/>
                                        </Viewport3D.Camera>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <Model3DGroup x:Name="MeshModelGroup">
                                                    <AmbientLight Color="#888888"/>
                                                    <DirectionalLight Color="White"   Direction="-1,-2,-1"/>
                                                    <DirectionalLight Color="#606060" Direction="1,1,1"/>
                                                </Model3DGroup>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                    </Viewport3D>
                                    <TextBlock x:Name="MeshInfoText" Foreground="#858585"
                                               FontFamily="Consolas" FontSize="10"
                                               TextAlignment="Center" Padding="4,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Properties">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="#1E1E1E">
                        <TextBlock x:Name="PropertiesText" Foreground="#CCCCCC"
                                   FontFamily="Consolas" FontSize="11"
                                   Margin="14" LineHeight="18" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Dump">
                    <DockPanel Background="#1E1E1E">
                        <Border DockPanel.Dock="Top" Background="#2D2D30"
                                BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                        <Button Content="Export File…" Style="{StaticResource DarkButton}"
                            Padding="10,3" Click="DumpExport_Click"/>
                        <Button Content="Export Raw Bytes…" Style="{StaticResource DarkButton}"
                            Padding="10,3" Margin="8,0,0,0" Click="DumpExportRaw_Click"/>
                        </StackPanel>
                        </Border>
                        <TextBox x:Name="DumpHexText" IsReadOnly="True" TextWrapping="NoWrap"
                                 Background="#111" Foreground="#CE9178"
                                 FontFamily="Consolas" FontSize="10" Padding="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0"/>
                    </DockPanel>
                </TabItem>
                </TabControl>

            </Grid>

        </Grid>
    </DockPanel>
</Window>
